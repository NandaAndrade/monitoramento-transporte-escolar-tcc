#000000;" vertex="1" parent="1"><mxGeometry x="720" y="413" width="24" height="24" as="geometry" /></mxCell><mxCell id="c22" value="recebido" style="endArrow=open;endFill=0;endSize=8;html=1;labelBackgroundColor=#FFFFFF;strokeColor=#000000;fontFamily=Times New Roman;fontSize=11;fontColor=#000000;" edge="1" parent="1" source="c18" target="c19"><mxGeometry relative="1" as="geometry" /></mxCell><mxCell id="c23" value="fim do ano letivo&lt;br&gt;+ 1 ano" style="endArrow=open;endFill=0;endSize=8;html=1;labelBackgroundColor=#FFFFFF;strokeColor=#000000;fontFamily=Times New Roman;fontSize=11;fontColor=#000000;" edge="1" parent="1" source="c19" target="c20"><mxGeometry relative="1" as="geometry" /></mxCell><mxCell id="c24" value="" style="endArrow=open;endFill=0;endSize=8;html=1;labelBackgroundColor=#FFFFFF;strokeColor=#000000;fontFamily=Times New Roman;fontSize=11;fontColor=#000000;" edge="1" parent="1" source="c20" target="c21"><mxGeometry relative="1" as="geometry" /></mxCell><mxCell id="c25" value="O dispositivo só guarda o que ainda&lt;br&gt;não foi enviado (RNF-16). Gravar o&lt;br&gt;mesmo id duas vezes não duplica o&lt;br&gt;evento (RF-08)." style="shape=note;size=14;whiteSpace=wrap;html=1;align=left;spacingLeft=6;fillColor=#FFFFFF;strokeColor=#000000;fontFamily=Times New Roman;fontSize=11;fontColor=#000000;" vertex="1" parent="1"><mxGeometry x="840" y="360" width="260" height="80" as="geometry" /></mxCell></root></mxGraphModel></diagram><diagram id="atividades_reconhecimento" name="1.3 Atividades do reconhecimento"><mxGraphModel dx="1200" dy="800" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1180" pageHeight="1330" math="0" shadow="0" background="#FFFFFF"><root><mxCell id="0" /><mxCell id="1" parent="0" /><mxCell id="c1" value="" style="ellipse;html=1;fillColor=#000000;strokeColor=#000000;" vertex="1" parent="1"><mxGeometry x="390" y="15" width="20" height="20" as="geometry" /></mxCell><mxCell id="c2"