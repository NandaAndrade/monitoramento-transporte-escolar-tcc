F;strokeColor=#000000;fontFamily=Times New Roman;fontSize=12;fontColor=#000000;" vertex="1" parent="1"><mxGeometry x="940" y="420" width="30" height="60" as="geometry" /></mxCell><mxCell id="c6" value="&lt;b&gt;TRANSCOLAR RURAL&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:10px&quot;&gt;sistema externo (backend e relatórios)&lt;/font&gt;" style="rounded=1;arcSize=12;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#000000;fontFamily=Times New Roman;fontSize=12;fontColor=#000000;" vertex="1" parent="1"><mxGeometry x="880" y="240" width="260" height="70" as="geometry" /></mxCell><mxCell id="c7" value="rosto capturado pela câmera&lt;br&gt;na porta do ônibus" style="endArrow=classic;endFill=1;html=1;labelBackgroundColor=#FFFFFF;strokeColor=#000000;fontFamily=Times New Roman;fontSize=11;fontColor=#000000;" edge="1" parent="1" source="c2" target="c1"><mxGeometry relative="1" as="geometry" /></mxCell><mxCell id="c8" value="retorno local:&lt;br&gt;LED e bipe" style="endArrow=classic;endFill=1;html=1;labelBackgroundColor=#FFFFFF;strokeColor=#000000;fontFamily=Times New Roman;fontSize=11;fontColor=#000000;" edge="1" parent="1" source="c1" target="c3"><mxGeometry relative="1" as="geometry" /></mxCell><mxCell id="c9" value="eventos de presença&lt;br&gt;(MQTT, rede móvel)" style="endArrow=classic;endFill=1;html=1;labelBackgroundColor=#FFFFFF;strokeColor=#000000;fontFamily=Times New Roman;fontSize=11;fontColor=#000000;" edge="1" parent="1" source="c1" target="c6"><mxGeometry relative="1" as="geometry" /></mxCell><mxCell id="c10" value="cadastros, consentimento,&lt;br&gt;referências biométricas" style="endArrow=classic;endFill=1;html=1;labelBackgroundColor=#FFFFFF;strokeColor=#000000;fontFamily=Times New Roman;fontSize=11;fontColor=#000000;" edge="1" parent="1" source="c4" target="c6"><mxGeometry relative="1" as="geometry" /></mxCell><mxCell id="c11" value="relatórios" style="endArrow=classic;endFill=1;html=1;labelBackgroundColor=#FFFFFF;strokeColor=#000000;fontFamily=Time