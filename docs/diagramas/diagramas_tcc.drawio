 Roman;fontSize=11;fontColor=#000000;" vertex="1" parent="1"><mxGeometry x="267" y="523" width="860" height="20" as="geometry" /></mxCell><mxCell id="c15" value="" style="endArrow=none;dashed=1;html=1;strokeColor=#000000;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="205" y="515" as="sourcePoint" /><mxPoint x="1135" y="515" as="targetPoint" /></mxGeometry></mxCell><mxCell id="c16" value="publicar(evento)" style="endArrow=block;endFill=1;html=1;strokeColor=#000000;fontFamily=Times New Roman;fontSize=11;fontColor=#000000;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="280" y="305" as="sourcePoint" /><mxPoint x="660" y="305" as="targetPoint" /><mxPoint x="0" y="-9" as="offset" /></mxGeometry></mxCell><mxCell id="c17" value="PUBLISH (QoS 1, id do evento)" style="endArrow=block;endFill=1;html=1;strokeColor=#000000;fontFamily=Times New Roman;fontSize=11;fontColor=#000000;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="660" y="335" as="sourcePoint" /><mxPoint x="850" y="335" as="targetPoint" /><mxPoint x="0" y="-9" as="offset" /></mxGeometry></mxCell><mxCell id="c18" value="entrega o evento" style="endArrow=block;endFill=1;html=1;strokeColor=#000000;fontFamily=Times New Roman;fontSize=11;fontColor=#000000;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="850" y="365" as="sourcePoint" /><mxPoint x="1040" y="365" as="targetPoint" /><mxPoint x="0" y="-9" as="offset" /></mxGeometry></mxCell><mxCell id="c19" value="" style="endArrow=block;endFill=1;html=1;strokeColor=#000000;fontFamily=Times New Roman;fontSize=11;fontColor=#000000;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="1040" y="380" as="sourcePoint" /><mxPoint x="1040" y="408" as="targetPoint" /><Array as="points"><mxPoint x="1080" y="380" /><mxPoint x="1080" y="408" /></Array></mxGeometry></mxCell><mxCell id="c20" value="descarta id&lt;br&gt;repetido (RF-08)" style="text;html=1;align=left;verticalAlign=middle;whiteSpace=nowrap;fontFamily=Times New Roman;fontSize=11;fontColor=#000000;" vertex="1" parent="1"><mxGeometry x="1086" y="376" width="200" height="36" as="geometry" /></mxCell><mxCell id="c21" value="PUBACK" style="endArrow=open;endFill=0;dashed=1;html=1;strokeColor=#000000;fontFamily=Times New Roman;fontSize=11;fontColor=#000000;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="850" y="435" as="sourcePoint" /><mxPoint x="660" y="435" as="targetPoint" /><mxPoint x="0" y="-9" as="offset" /></mxGeometry></mxCell><mxCell id="c22" value="True" style="endArrow=open;endFill=0;dashed=1;html=1;strokeColor=#000000;fontFamily=Times New Roman;fontSize=11;fontColor=#000000;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="660" y="462" as="sourcePoint" /><mxPoint x="280" y="462" as="targetPoint" /><mxPoint x="0" y="-9" as="offset" /></mxGeometry></mxCell><mxCell id="c23" value="confirmar_envio(id): apaga o evento" style="endArrow=block;endFill=1;html=1;strokeColor=#000000;fontFamily=Times New Roman;fontSize=11;fontColor=#000000;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="280" y="492" as="sourcePoint" /><mxPoint x="470" y="492" as="targetPoint" /><mxPoint x="0" y="-9" as="offset" /></mxGeometry></mxCell><mxCell id="c24" value="publicar(evento)" style="endArrow=block;endFill=1;html=1;strokeColor=#000000;fontFamily=Times New Roman;fontSize=11;fontColor=#000000;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="280" y="565" as="sourcePoint" /><mxPoint x="660" y="565" as="targetPoint" /><mxPoint x="0" y="-9" as="offset" /></mxGeometry></mxCell><mxCell id="c25" value="False" style="endArrow=open;endFill=0;dashed=1;html=1;strokeColor=#000000;fontFamily=Times New Roman;fontSize=11;fontColor=#000000;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="660" y="595" as="sourcePoint" /><mxPoint x="280" y="595" as="targetPoint" /><mxPoint x="0" y="-9" as="offset" /></mxGeometry></mxCell><mxCell id="c26" value="" style="endArrow=block;endFill=1;html=1;strokeColor=#000000;fontFamily=Times New Roman;fontSize=11;fontColor=#000000;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="280" y="610" as="sourcePoint" /><mxPoint x="280" y="638" as="targetPoint" /><Array as="points"><mxPoint x="320" y="610" /><mxPoint x="320" y="638" /></Array></mxGeometry></mxCell><mxCell id="c27" value="interrompe o lote; o evento&lt;br&gt;continua na fila" style="text;html=1;align=left;verticalAlign=middle;whiteSpace=nowrap;fontFamily=Times New Roman;fontSize=11;fontColor=#000000;" vertex="1" parent="1"><mxGeometry x="326" y="606" width="200" height="36" as="geometry" /></mxCell><mxCell id="c28" value="Sem rede, os eventos se acumulam na fila e saem em ordem quando a conexão volta (RF-07).&lt;br&gt;Se o PUBACK se perder, o evento é reenviado na próxima sincronização e o backend&lt;br&gt;descarta o id repetido: nenhum evento se perde nem se duplica (RF-08)." style="shape=note;size=14;whiteSpace=wrap;html=1;align=left;spacingLeft=6;fillColor=#FFFFFF;strokeColor=#000000;fontFamily=Times New Roman;fontSize=11;fontColor=#000000;" vertex="1" parent="1"><mxGeometry x="20" y="715" width="540" height="60" as="geometry" /></mxCell></root></mxGraphModel></diagram><diagram id="estados_evento" name="1.3 Estados do evento"><mxGraphModel dx="1200" dy="800" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1140" pageHeight="520" math="0" shadow="0" background="#FFFFFF"><root><mxCell id="0" /><mxCell id="1" parent="0" /><mxCell id="c1" value="No dispositivo" style="rounded=0;whiteSpace=wrap;html=1;verticalAlign=top;align=left;spacingLeft=10;fillColor=none;fontStyle=1;spacingTop=4;strokeColor=#000000;fontFamily=Times New Roman;fontSize=12;fontColor=#000000;dashed=1;" vertex="1" parent="1"><mxGeometry x="20" y="20" width="1100" height="290" as="geometry" /></mxCell><mxCell id="c2" valu